<section class="hero hero--background-models su-editable-section"
  style="--hero-opacity: {{ section.settings.opacity | divided_by: 100.0 }}; --hero-min-height: {{ section.settings.hero_height }}px; --hero-radius: {{ section.settings.corner_radius }}px; --hero-bg-x: {{ section.settings.models_x }}%; --hero-bg-y: {{ section.settings.models_y }}%; --hero-bg-scale: {{ section.settings.models_scale | divided_by: 100.0 }}; --hero-overlay: {{ section.settings.overlay_strength | divided_by: 100.0 }}; --hero-copy-x: {{ section.settings.copy_x }}px; --hero-copy-y: {{ section.settings.copy_y }}px; --hero-copy-width: {{ section.settings.copy_width }}px; --hero-align: {{ section.settings.text_align }}; --hero-title-size: {{ section.settings.title_size }}px; --hero-text-size: {{ section.settings.body_size }}px; --hero-margin-top: {{ section.settings.margin_top }}px; --hero-margin-bottom: {{ section.settings.margin_bottom }}px; --hero-padding-top: {{ section.settings.padding_top }}px; --hero-padding-bottom: {{ section.settings.padding_bottom }}px; --hero-content-position: {{ section.settings.content_position }}; --hero-title-color: {{ section.settings.title_color }}; --hero-body-color: {{ section.settings.body_color }}; --hero-eyebrow-color: {{ section.settings.eyebrow_color }};"
  data-section-id="{{ section.id }}">
  <div class="hero__media hero__media--bg" aria-hidden="true">
    {% if section.settings.background_image != blank %}
      {{ section.settings.background_image | image_url: width: 2400 | image_tag: loading: 'eager', alt: section.settings.heading }}
    {% else %}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
    {% endif %}
  </div>

  <div class="hero__copy hero__copy--{{ section.settings.content_position }}">
    {% if section.settings.eyebrow != blank %}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{% endif %}
    {% if section.settings.heading != blank %}<h1>{{ section.settings.heading }}</h1>{% endif %}
    {% if section.settings.text != blank %}<p>{{ section.settings.text }}</p>{% endif %}
    <div class="hero__actions hero__actions--{{ section.settings.button_align }}">
      {% assign primary_url = section.settings.primary_link | default: routes.collections_url %}
      {% assign secondary_url = section.settings.secondary_link | default: "/pages/contacto" %}
      {% if section.settings.primary_label != blank %}<a class="btn btn--gold" href="{{ primary_url }}">{{ section.settings.primary_label }}</a>{% endif %}
      {% if section.settings.secondary_label != blank %}<a class="btn btn--ghost" href="{{ secondary_url }}">{{ section.settings.secondary_label }}</a>{% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero modelos Suave",
  "settings": [
    {
      "type": "header",
      "content": "Imagen/modelos"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Imagen/modelos de fondo"
    },
    {
      "type": "range",
      "id": "opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Visibilidad de modelos",
      "default": 60
    },
    {
      "type": "range",
      "id": "models_x",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "Mover modelos izquierda/derecha",
      "default": 70
    },
    {
      "type": "range",
      "id": "models_y",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "Mover modelos arriba/abajo",
      "default": 50
    },
    {
      "type": "range",
      "id": "models_scale",
      "min": 80,
      "max": 140,
      "step": 2,
      "unit": "%",
      "label": "Tamaño/zoom de modelos",
      "default": 100
    },
    {
      "type": "range",
      "id": "overlay_strength",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Oscuridad encima de modelos",
      "default": 80
    },
    {
      "type": "header",
      "content": "Texto"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Texto superior",
      "default": "Suave Urban Studio"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Tu estilo, tus diseños, tu tienda"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Descripción",
      "default": "Compra, personaliza y da seguimiento a tus pedidos con un diseño premium y urbano."
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Alineación del texto",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Izquierda"
        },
        {
          "value": "center",
          "label": "Centro"
        },
        {
          "value": "right",
          "label": "Derecha"
        }
      ]
    },
    {
      "type": "select",
      "id": "content_position",
      "label": "Posición base del bloque de texto",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Izquierda"
        },
        {
          "value": "center",
          "label": "Centro"
        },
        {
          "value": "right",
          "label": "Derecha"
        }
      ]
    },
    {
      "type": "range",
      "id": "copy_x",
      "min": -1200,
      "max": 1200,
      "step": 10,
      "unit": "px",
      "label": "Mover texto izquierda/derecha",
      "default": 0
    },
    {
      "type": "range",
      "id": "copy_y",
      "min": -1200,
      "max": 1200,
      "step": 10,
      "unit": "px",
      "label": "Mover texto arriba/abajo",
      "default": 0
    },
    {
      "type": "range",
      "id": "copy_width",
      "min": 200,
      "max": 2400,
      "step": 20,
      "unit": "px",
      "label": "Ancho del bloque de texto",
      "default": 760
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 36,
      "max": 120,
      "step": 2,
      "unit": "px",
      "label": "Tamaño del título",
      "default": 88
    },
    {
      "type": "range",
      "id": "body_size",
      "min": 14,
      "max": 32,
      "step": 1,
      "unit": "px",
      "label": "Tamaño de descripción",
      "default": 20
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Color texto superior",
      "default": "#d4af37"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Color título",
      "default": "#f7f0df"
    },
    {
      "type": "color",
      "id": "body_color",
      "label": "Color descripción",
      "default": "#d8d0be"
    },
    {
      "type": "header",
      "content": "Botones"
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "Texto botón principal",
      "default": "Ver colecciones"
    },
    {
      "type": "url",
      "id": "primary_link",
      "label": "Link principal"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Texto botón secundario",
      "default": "Personalizar pedido"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Link secundario"
    },
    {
      "type": "select",
      "id": "button_align",
      "label": "Alineación de botones",
      "default": "start",
      "options": [
        {
          "value": "start",
          "label": "Izquierda"
        },
        {
          "value": "center",
          "label": "Centro"
        },
        {
          "value": "end",
          "label": "Derecha"
        }
      ]
    },
    {
      "type": "header",
      "content": "Espacios y forma"
    },
    {
      "type": "range",
      "id": "hero_height",
      "min": 420,
      "max": 900,
      "step": 20,
      "unit": "px",
      "label": "Alto del hero",
      "default": 660
    },
    {
      "type": "range",
      "id": "corner_radius",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Redondeo",
      "default": 44
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 20,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Espacio interno arriba",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 20,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Espacio interno abajo",
      "default": 72
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": -40,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Espacio externo arriba",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Espacio externo abajo",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Hero modelos Suave"
    }
  ]
}
{% endschema %}
