<section class="su-editable-section cart-page-section" style="--section-margin-top: {{ section.settings.margin_top }}px; --section-margin-bottom: {{ section.settings.margin_bottom }}px; --section-padding-top: {{ section.settings.padding_top }}px; --section-padding-bottom: {{ section.settings.padding_bottom }}px; --cart-head-x: {{ section.settings.heading_x }}px; --cart-head-y: {{ section.settings.heading_y }}px; --cart-align: {{ section.settings.text_align }};">
  <div class="page-title page-title--editable" style="--collection-head-x: var(--cart-head-x); --collection-head-y: var(--cart-head-y); --collection-align: var(--cart-align);">
    <p>{{ section.settings.eyebrow }}</p>
    <h1>{{ section.settings.heading }}</h1>
    {% if section.settings.text != blank %}<span>{{ section.settings.text }}</span>{% endif %}
  </div>

  {% if cart.item_count == 0 %}
    <div class="empty-state">{{ section.settings.empty_text }}</div>
    <a class="btn btn--gold" href="{{ routes.collections_url }}">{{ section.settings.empty_button_label }}</a>
  {% else %}
    <form action="{{ routes.cart_url }}" method="post" novalidate>
      <div class="cart-list">
        {% for item in cart.items %}
          <article class="cart-item">
            <span>
              {% if item.image %}{{ item.image | image_url: width: 180 | image_tag: loading: 'lazy', alt: item.product.title }}{% else %}SU{% endif %}
            </span>
            <div>
              <h3><a href="{{ item.url }}">{{ item.product.title }}</a></h3>
              {% unless item.product.has_only_default_variant %}<p>{{ item.variant.title }}</p>{% endunless %}
              <strong>{{ item.final_line_price | money }}</strong>
            </div>
            <div class="qty">
              <label class="visually-hidden" for="updates_{{ item.key }}">{{ section.settings.quantity_label }}</label>
              <input id="updates_{{ item.key }}" name="updates[]" type="number" min="0" value="{{ item.quantity }}">
            </div>
            <a class="remove" href="{{ item.url_to_remove }}">{{ section.settings.remove_label }}</a>
          </article>
        {% endfor %}
      </div>

      <div class="cart-total"><b>{{ section.settings.total_label }}</b><strong>{{ cart.total_price | money }}</strong></div>
      <div class="detail-actions detail-actions--{{ section.settings.button_align }}">
        <button class="btn btn--ghost" type="submit" name="update">{{ section.settings.update_label }}</button>
        <button class="btn btn--gold" type="submit" name="checkout">{{ section.settings.checkout_label }}</button>
      </div>
    </form>
  {% endif %}
</section>

{% schema %}
{
  "name": "Carrito principal",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Texto superior",
      "default": "Compra"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Carrito"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Texto descriptivo"
    },
    {
      "type": "text",
      "id": "empty_text",
      "label": "Texto carrito vacío",
      "default": "Tu carrito está vacío."
    },
    {
      "type": "text",
      "id": "empty_button_label",
      "label": "Botón carrito vacío",
      "default": "Ver colecciones"
    },
    {
      "type": "text",
      "id": "quantity_label",
      "label": "Texto cantidad",
      "default": "Cantidad"
    },
    {
      "type": "text",
      "id": "remove_label",
      "label": "Texto eliminar",
      "default": "Eliminar"
    },
    {
      "type": "text",
      "id": "total_label",
      "label": "Texto total",
      "default": "Total"
    },
    {
      "type": "text",
      "id": "update_label",
      "label": "Botón actualizar",
      "default": "Actualizar"
    },
    {
      "type": "text",
      "id": "checkout_label",
      "label": "Botón finalizar",
      "default": "Finalizar compra"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Alineación encabezado",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Izquierda"
        },
        {
          "value": "center",
          "label": "Centro"
        },
        {
          "value": "right",
          "label": "Derecha"
        }
      ]
    },
    {
      "type": "select",
      "id": "button_align",
      "label": "Alineación botones",
      "default": "start",
      "options": [
        {
          "value": "start",
          "label": "Izquierda"
        },
        {
          "value": "center",
          "label": "Centro"
        },
        {
          "value": "end",
          "label": "Derecha"
        }
      ]
    },
    {
      "type": "range",
      "id": "heading_x",
      "min": -220,
      "max": 220,
      "step": 4,
      "unit": "px",
      "label": "Mover encabezado izquierda/derecha",
      "default": 0
    },
    {
      "type": "range",
      "id": "heading_y",
      "min": -160,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Mover encabezado arriba/abajo",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Espacio interno arriba",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Espacio interno abajo",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Espacio externo arriba",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Espacio externo abajo",
      "default": 0
    }
  ]
}
{% endschema %}
