<section class="su-editable-section password-section" style="text-align:center;min-height:60vh;display:grid;place-items:center">
  <div class="clean-panel" style="max-width:640px;margin:auto;padding:38px">
    {% if section.settings.logo != blank %}
      {{ section.settings.logo | image_url: width: 260 | image_tag: loading: 'eager', alt: shop.name, class: 'password-logo' }}
    {% endif %}
    <p class="eyebrow">{{ section.settings.eyebrow }}</p>
    <h1>{{ section.settings.heading }}</h1>
    <p>{{ section.settings.text }}</p>
    {% form 'storefront_password' %}
      {{ form.errors | default_errors }}
      <div class="field" style="margin:20px 0;text-align:left">
        <label for="Password">{{ section.settings.password_label }}</label>
        <input class="field__input" type="password" name="password" id="Password" autocomplete="current-password">
      </div>
      <button class="btn btn--gold" type="submit">{{ section.settings.button_label }}</button>
    {% endform %}
  </div>
</section>

{% schema %}
{
  "name": "Página con contraseña",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    { "type": "text", "id": "eyebrow", "label": "Texto superior", "default": "Muy pronto" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Suave Urban Studio" },
    { "type": "textarea", "id": "text", "label": "Texto", "default": "Nuestra tienda está protegida temporalmente." },
    { "type": "text", "id": "password_label", "label": "Texto contraseña", "default": "Contraseña" },
    { "type": "text", "id": "button_label", "label": "Botón", "default": "Entrar" }
  ]
}
{% endschema %}
