<section class="su-editable-section search-page-section" style="--section-margin-top: {{ section.settings.margin_top }}px; --section-margin-bottom: {{ section.settings.margin_bottom }}px; --section-padding-top: {{ section.settings.padding_top }}px; --section-padding-bottom: {{ section.settings.padding_bottom }}px; --search-head-x: {{ section.settings.heading_x }}px; --search-head-y: {{ section.settings.heading_y }}px; --search-align: {{ section.settings.text_align }}; --search-form-x: {{ section.settings.form_x }}px; --search-form-y: {{ section.settings.form_y }}px; --product-grid-columns: {{ section.settings.columns }}; --product-grid-gap: {{ section.settings.gap }}px;">
  <div class="page-title page-title--editable" style="--collection-head-x: var(--search-head-x); --collection-head-y: var(--search-head-y); --collection-align: var(--search-align);">
    <p>{{ section.settings.eyebrow }}</p>
    <h1>{{ section.settings.heading }}</h1>
    {% if section.settings.text != blank %}<span>{{ section.settings.text }}</span>{% endif %}
  </div>

  <form action="{{ routes.search_url }}" method="get" role="search" class="clean-panel search-panel">
    <div class="field">
      <label for="SearchInput">{{ section.settings.input_label }}</label>
      <input class="field__input" id="SearchInput" type="search" name="q" value="{{ search.terms | escape }}">
    </div>
    <button class="btn btn--gold" type="submit">{{ section.settings.button_label }}</button>
  </form>

  {% if search.performed %}
    {% paginate search.results by section.settings.products_per_page %}
      <section class="product-grid product-grid--editable" style="margin-top:24px">
        {% for item in search.results %}
          {% if item.object_type == 'product' %}
            {% render 'product-card', product: item, view_label: section.settings.view_product_label, buy_label: section.settings.buy_label, show_quick_buy: section.settings.show_quick_buy %}
          {% endif %}
        {% else %}
          <div class="empty-state">{{ section.settings.no_results_text }}</div>
        {% endfor %}
      </section>
      {% if paginate.pages > 1 %}<nav class="pagination">{{ paginate | default_pagination }}</nav>{% endif %}
    {% endpaginate %}
  {% endif %}
</section>

{% schema %}
{
  "name": "Búsqueda principal",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Texto superior",
      "default": "Buscar"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Resultados"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Texto descriptivo"
    },
    {
      "type": "text",
      "id": "input_label",
      "label": "Texto campo buscar",
      "default": "Buscar productos"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Botón buscar",
      "default": "Buscar"
    },
    {
      "type": "text",
      "id": "no_results_text",
      "label": "Texto sin resultados",
      "default": "No encontramos resultados para tu búsqueda."
    },
    {
      "type": "text",
      "id": "view_product_label",
      "label": "Botón ver producto",
      "default": "Ver modelo"
    },
    {
      "type": "text",
      "id": "buy_label",
      "label": "Botón comprar",
      "default": "Comprar"
    },
    {
      "type": "checkbox",
      "id": "show_quick_buy",
      "label": "Mostrar comprar directo",
      "default": true
    },
    {
      "type": "range",
      "id": "products_per_page",
      "min": 8,
      "max": 48,
      "step": 4,
      "label": "Resultados por página",
      "default": 24
    },
    {
      "type": "range",
      "id": "columns",
      "min": 2,
      "max": 6,
      "step": 1,
      "label": "Columnas escritorio",
      "default": 4
    },
    {
      "type": "range",
      "id": "gap",
      "min": 8,
      "max": 42,
      "step": 2,
      "unit": "px",
      "label": "Separación productos",
      "default": 18
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Alineación encabezado",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Izquierda"
        },
        {
          "value": "center",
          "label": "Centro"
        },
        {
          "value": "right",
          "label": "Derecha"
        }
      ]
    },
    {
      "type": "range",
      "id": "heading_x",
      "min": -220,
      "max": 220,
      "step": 4,
      "unit": "px",
      "label": "Mover encabezado izquierda/derecha",
      "default": 0
    },
    {
      "type": "range",
      "id": "heading_y",
      "min": -160,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Mover encabezado arriba/abajo",
      "default": 0
    },
    {
      "type": "range",
      "id": "form_x",
      "min": -220,
      "max": 220,
      "step": 4,
      "unit": "px",
      "label": "Mover buscador izquierda/derecha",
      "default": 0
    },
    {
      "type": "range",
      "id": "form_y",
      "min": -160,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Mover buscador arriba/abajo",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Espacio interno arriba",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Espacio interno abajo",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Espacio externo arriba",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Espacio externo abajo",
      "default": 0
    }
  ]
}
{% endschema %}
