<section class="su-editable-section free-section free-section--{{ section.settings.layout }}"
  style="--section-margin-top: {{ section.settings.margin_top }}px; --section-margin-bottom: {{ section.settings.margin_bottom }}px; --section-padding-top: {{ section.settings.padding_top }}px; --section-padding-bottom: {{ section.settings.padding_bottom }}px; --free-min-height: {{ section.settings.min_height }}px; --free-radius: {{ section.settings.radius }}px; --free-bg: {{ section.settings.background_color }}; --free-border-opacity: {{ section.settings.border_opacity | divided_by: 100.0 }}; --free-gap: {{ section.settings.gap }}px; --free-columns: {{ section.settings.columns }}; --free-align: {{ section.settings.text_align }};">
  {% if section.settings.background_image != blank %}
    <div class="free-section__bg" style="--free-bg-opacity: {{ section.settings.background_image_opacity | divided_by: 100.0 }}; --free-bg-x: {{ section.settings.background_x }}%; --free-bg-y: {{ section.settings.background_y }}%;">
      {{ section.settings.background_image | image_url: width: 2200 | image_tag: loading: 'lazy', alt: section.settings.heading }}
    </div>
  {% endif %}

  <div class="free-section__inner">
    {% if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.text != blank %}
      <div class="section-head section-head--editable free-section__head" style="--free-head-x: {{ section.settings.heading_x }}px; --free-head-y: {{ section.settings.heading_y }}px;">
        {% if section.settings.eyebrow != blank %}<p>{{ section.settings.eyebrow }}</p>{% endif %}
        {% if section.settings.heading != blank %}<h2>{{ section.settings.heading }}</h2>{% endif %}
        {% if section.settings.text != blank %}<span>{{ section.settings.text }}</span>{% endif %}
      </div>
    {% endif %}

    <div class="free-section__blocks">
      {% for block in section.blocks %}
        <div class="free-block free-block--{{ block.type }}" style="--free-block-x: {{ block.settings.move_x }}px; --free-block-y: {{ block.settings.move_y }}px; --free-block-width: {{ block.settings.width }}px; --free-block-align: {{ block.settings.text_align }}; --free-block-title-size: {{ block.settings.title_size }}px; --free-block-text-size: {{ block.settings.text_size }}px; --free-block-radius: {{ block.settings.radius }}px;" {{ block.shopify_attributes }}>
          {% case block.type %}
            {% when 'text' %}
              {% if block.settings.eyebrow != blank %}<p class="eyebrow">{{ block.settings.eyebrow }}</p>{% endif %}
              {% if block.settings.title != blank %}<h3>{{ block.settings.title }}</h3>{% endif %}
              {% if block.settings.text != blank %}<div class="rte">{{ block.settings.text }}</div>{% endif %}
            {% when 'image' %}
              {% if block.settings.image != blank %}
                <a {% if block.settings.link != blank %}href="{{ block.settings.link }}"{% endif %} class="free-image" style="--free-image-height: {{ block.settings.image_height }}px; --free-image-x: {{ block.settings.image_x }}%; --free-image-y: {{ block.settings.image_y }}%;">
                  {{ block.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', alt: block.settings.title }}
                </a>
              {% endif %}
              {% if block.settings.title != blank %}<h3>{{ block.settings.title }}</h3>{% endif %}
            {% when 'button' %}
              {% if block.settings.title != blank %}<h3>{{ block.settings.title }}</h3>{% endif %}
              {% if block.settings.text != blank %}<p>{{ block.settings.text }}</p>{% endif %}
              {% if block.settings.button_label != blank %}<a class="btn {% if block.settings.button_style == 'gold' %}btn--gold{% else %}btn--ghost{% endif %}" href="{{ block.settings.button_link }}">{{ block.settings.button_label }}</a>{% endif %}
            {% when 'collection' %}
              {% assign collection = block.settings.collection %}
              {% if collection != blank %}
                <a class="free-collection" href="{{ collection.url }}">
                  {% if block.settings.image != blank %}
                    {{ block.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', alt: collection.title }}
                  {% elsif collection.image != blank %}
                    {{ collection.image | image_url: width: 1000 | image_tag: loading: 'lazy', alt: collection.title }}
                  {% endif %}
                  <h3>{% if block.settings.title != blank %}{{ block.settings.title }}{% else %}{{ collection.title }}{% endif %}</h3>
                  {% if block.settings.text != blank %}<p>{{ block.settings.text }}</p>{% endif %}
                </a>
              {% endif %}
            {% when 'product' %}
              {% assign product = block.settings.product %}
              {% if product != blank %}
                {% render 'product-card', product: product, view_label: block.settings.view_label, buy_label: block.settings.buy_label, show_quick_buy: block.settings.show_quick_buy %}
              {% endif %}
          {% endcase %}
        </div>
      {% endfor %}
    </div>
  </div>
</section>

