<section class="su-editable-section category-section"
  style="--section-margin-top: {{ section.settings.margin_top }}px; --section-margin-bottom: {{ section.settings.margin_bottom }}px; --section-padding-top: {{ section.settings.padding_top }}px; --section-padding-bottom: {{ section.settings.padding_bottom }}px; --section-align: {{ section.settings.heading_align }}; --category-columns: {{ section.settings.columns }}; --category-gap: {{ section.settings.gap }}px; --category-height: {{ section.settings.card_height }}px; --category-radius: {{ section.settings.card_radius }}px; --category-image-opacity: {{ section.settings.image_opacity | divided_by: 100.0 }}; --category-overlay: {{ section.settings.overlay_strength | divided_by: 100.0 }};">
  <div class="section-head section-head--editable">
    {% if section.settings.eyebrow != blank %}<p>{{ section.settings.eyebrow }}</p>{% endif %}
    {% if section.settings.heading != blank %}<h2>{{ section.settings.heading }}</h2>{% endif %}
    {% if section.settings.text != blank %}<span>{{ section.settings.text }}</span>{% endif %}
  </div>

  <div class="category-grid category-grid--editable">
    {% for block in section.blocks %}
      {% assign collection = block.settings.collection %}
      {% assign image = block.settings.image %}
      <a class="category-card category-card--editable" href="{% if collection != blank %}{{ collection.url }}{% else %}{{ block.settings.link }}{% endif %}" style="--card-text-x: {{ block.settings.text_x }}px; --card-text-y: {{ block.settings.text_y }}px; --card-text-align: {{ block.settings.text_align }}; --card-image-x: {{ block.settings.image_x }}%; --card-image-y: {{ block.settings.image_y }}%; --card-title-size: {{ block.settings.title_size }}px;" {{ block.shopify_attributes }}>
        <span class="category-card__image">
          {% if image != blank %}
            {{ image | image_url: width: 900 | image_tag: loading: 'lazy', alt: block.settings.title }}
          {% elsif collection.image != blank %}
            {{ collection.image | image_url: width: 900 | image_tag: loading: 'lazy', alt: collection.title }}
          {% elsif collection.products.first.featured_image != blank %}
            {{ collection.products.first.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', alt: collection.title }}
          {% endif %}
        </span>
        <span class="category-card__content">
          <b>{% if block.settings.title != blank %}{{ block.settings.title }}{% elsif collection != blank %}{{ collection.title }}{% else %}Categoría{% endif %}</b>
          {% if block.settings.text != blank %}<small>{{ block.settings.text }}</small>{% endif %}
          {% if block.settings.button_label != blank %}<em>{{ block.settings.button_label }}</em>{% endif %}
        </span>
      </a>
    {% else %}
      <div class="empty-state">Agrega categorías/colecciones desde el editor del tema.</div>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Categorías editables",
  "settings": [
    {
      "type": "header",
      "content": "Encabezado"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Texto superior",
      "default": "Categorías principales"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Elige tu colección"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Texto descriptivo",
      "default": "Edita categorías, imágenes, textos y posición desde aquí."
    },
    {
      "type": "select",
      "id": "heading_align",
      "label": "Alineación del encabezado",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Izquierda"
        },
        {
          "value": "center",
          "label": "Centro"
        },
        {
          "value": "right",
          "label": "Derecha"
        }
      ]
    },
    {
      "type": "header",
      "content": "Diseño de tarjetas"
    },
    {
      "type": "range",
      "id": "columns",
      "min": 1,
      "max": 6,
      "step": 1,
      "label": "Columnas en escritorio",
      "default": 4
    },
    {
      "type": "range",
      "id": "gap",
      "min": 8,
      "max": 42,
      "step": 2,
      "unit": "px",
      "label": "Separación entre tarjetas",
      "default": 18
    },
    {
      "type": "range",
      "id": "card_height",
      "min": 180,
      "max": 520,
      "step": 10,
      "unit": "px",
      "label": "Alto de tarjetas",
      "default": 280
    },
    {
      "type": "range",
      "id": "card_radius",
      "min": 0,
      "max": 50,
      "step": 2,
      "unit": "px",
      "label": "Redondeo de tarjetas",
      "default": 30
    },
    {
      "type": "range",
      "id": "image_opacity",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Opacidad de imágenes",
      "default": 100
    },
    {
      "type": "range",
      "id": "overlay_strength",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Oscuridad sobre imagen",
      "default": 85
    },
    {
      "type": "header",
      "content": "Espacios"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Espacio interno arriba",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Espacio interno abajo",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 140,
      "step": 4,
      "unit": "px",
      "label": "Espacio externo arriba",
      "default": 48
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "min": 0,
      "max": 140,
      "step": 4,
      "unit": "px",
      "label": "Espacio externo abajo",
      "default": 16
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Categoría",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Colección conectada"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagen manual"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Nombre manual"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Descripción",
          "default": "Modelos listos para personalizar."
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Texto botón",
          "default": "Ver colección"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link manual"
        },
        {
          "type": "header",
          "content": "Mover texto dentro de esta tarjeta"
        },
        {
          "type": "range",
          "id": "text_x",
          "min": -120,
          "max": 120,
          "step": 4,
          "unit": "px",
          "label": "Mover texto izquierda/derecha",
          "default": 0
        },
        {
          "type": "range",
          "id": "text_y",
          "min": -160,
          "max": 120,
          "step": 4,
          "unit": "px",
          "label": "Mover texto arriba/abajo",
          "default": 0
        },
        {
          "type": "select",
          "id": "text_align",
          "label": "Alineación de texto",
          "default": "left",
          "options": [
            {
              "value": "left",
              "label": "Izquierda"
            },
            {
              "value": "center",
              "label": "Centro"
            },
            {
              "value": "right",
              "label": "Derecha"
            }
          ]
        },
        {
          "type": "range",
          "id": "title_size",
          "min": 18,
          "max": 46,
          "step": 1,
          "unit": "px",
          "label": "Tamaño del nombre",
          "default": 28
        },
        {
          "type": "range",
          "id": "image_x",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "label": "Mover imagen izquierda/derecha",
          "default": 50
        },
        {
          "type": "range",
          "id": "image_y",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "label": "Mover imagen arriba/abajo",
          "default": 50
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Categorías editables",
      "blocks": [
        {
          "type": "category",
          "settings": {
            "title": "Hombre"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Mujer"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Accesorios"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Novedades"
          }
        }
      ]
    }
  ]
}
{% endschema %}
