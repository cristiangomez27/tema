<section class="page-title">
  <p>{{ section.settings.eyebrow }}</p>
  <h1>{{ blog.title }}</h1>
</section>

{% paginate blog.articles by section.settings.articles_per_page %}
  <section class="product-grid">
    {% for article in blog.articles %}
      <article class="product-card">
        <a class="product-card__media" href="{{ article.url }}">
          {% if article.image != blank %}
            {{ article.image | image_url: width: 900 | image_tag: loading: 'lazy', alt: article.title }}
          {% else %}
            <span class="image-placeholder">SU</span>
          {% endif %}
        </a>
        <div class="product-card__body">
          <small>{{ article.published_at | date: '%d/%m/%Y' }}</small>
          <h3><a href="{{ article.url }}">{{ article.title }}</a></h3>
          <p>{{ article.excerpt_or_content | strip_html | truncate: 120 }}</p>
          <div class="product-card__actions"><a href="{{ article.url }}">Leer más</a></div>
        </div>
      </article>
    {% else %}
      <div class="empty-state">Aún no hay publicaciones.</div>
    {% endfor %}
  </section>
  {% if paginate.pages > 1 %}<nav class="pagination">{{ paginate | default_pagination }}</nav>{% endif %}
{% endpaginate %}

{% schema %}
{
  "name": "Blog principal",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Texto superior",
      "default": "Noticias"
    },
    {
      "type": "range",
      "id": "articles_per_page",
      "min": 4,
      "max": 24,
      "step": 2,
      "label": "Artículos por página",
      "default": 8
    }
  ]
}
{% endschema %}
