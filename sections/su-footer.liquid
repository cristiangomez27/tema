<footer class="site-footer site-footer--editable"
  style="--footer-margin-top: {{ section.settings.margin_top }}px; --footer-padding-top: {{ section.settings.padding_top }}px; --footer-padding-bottom: {{ section.settings.padding_bottom }}px; --footer-columns: {{ section.settings.columns }}; --footer-gap: {{ section.settings.gap }}px; --footer-align: {{ section.settings.text_align }}; --footer-heading-x: {{ section.settings.heading_x }}px; --footer-heading-y: {{ section.settings.heading_y }}px;">
  <div class="footer-grid footer-grid--editable">
    <div class="footer-brand-block">
      {% if section.settings.heading != blank %}<h2>{{ section.settings.heading | default: shop.name }}</h2>{% endif %}
      {% if section.settings.description != blank %}<p>{{ section.settings.description }}</p>{% endif %}
      {% if settings.whatsapp_number != blank and section.settings.whatsapp_label != blank %}
        <a class="btn btn--gold" href="https://wa.me/{{ settings.whatsapp_number | remove: ' ' | remove: '+' }}" target="_blank" rel="noopener">{{ section.settings.whatsapp_label }}</a>
      {% endif %}
    </div>

    {% for block in section.blocks %}
      <div class="footer-block footer-block--{{ block.type }}" style="--footer-block-x: {{ block.settings.block_x }}px; --footer-block-y: {{ block.settings.block_y }}px;" {{ block.shopify_attributes }}>
        {% if block.settings.title != blank %}<h3>{{ block.settings.title }}</h3>{% endif %}
        {% if block.type == 'menu' and block.settings.menu != blank %}
          {% for link in block.settings.menu.links %}
            <a href="{{ link.url }}">{{ link.title }}</a>
          {% endfor %}
        {% elsif block.type == 'text' %}
          <p>{{ block.settings.text }}</p>
        {% elsif block.type == 'social' %}
          <div class="socials">
            {% if block.settings.instagram != blank %}<a href="{{ block.settings.instagram }}" target="_blank" rel="noopener">{{ block.settings.instagram_label }}</a>{% endif %}
            {% if block.settings.facebook != blank %}<a href="{{ block.settings.facebook }}" target="_blank" rel="noopener">{{ block.settings.facebook_label }}</a>{% endif %}
            {% if block.settings.tiktok != blank %}<a href="{{ block.settings.tiktok }}" target="_blank" rel="noopener">{{ block.settings.tiktok_label }}</a>{% endif %}
          </div>
        {% elsif block.type == 'custom_link' %}
          {% if block.settings.link_label != blank %}<a class="btn btn--ghost" href="{{ block.settings.link }}">{{ block.settings.link_label }}</a>{% endif %}
        {% endif %}
      </div>
    {% endfor %}
  </div>
  {% if section.settings.copyright_text != blank %}
    {% assign current_year = 'now' | date: '%Y' %}
    {% assign copyright_line = section.settings.copyright_text | replace: '[year]', current_year | replace: '[shop]', shop.name %}
    <div class="footer-bottom">{{ copyright_line }}</div>
  {% else %}
    <div class="footer-bottom">© {{ 'now' | date: '%Y' }} {{ shop.name }}. Todos los derechos reservados.</div>
  {% endif %}
</footer>

