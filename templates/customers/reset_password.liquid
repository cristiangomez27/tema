<section class="page-title"><p>Clientes</p><h1>Restablecer contraseña</h1></section>
<div class="contact-card">
{% form 'reset_customer_password' %}
  {{ form.errors | default_errors }}
  <div class="field"><label for="ResetPassword">Contraseña nueva</label><input class="field__input" type="password" name="customer[password]" id="ResetPassword" required></div>
  <div class="field"><label for="PasswordConfirmation">Confirmar contraseña</label><input class="field__input" type="password" name="customer[password_confirmation]" id="PasswordConfirmation" required></div>
  <button class="btn btn--gold" type="submit">Guardar contraseña</button>
{% endform %}
</div>
